        },
        {
          "rule-number": 201,
          "rule-definition": {
            "match-conditions": [
              {
                "type": "prefix-in-prefix-list",
                "value": "THPD-WORKLOAD-SUMMARY"
              }
            ],
            "condition-logic": "or",
            "action": {
              "type": "add-community",
              "value": "[AWS-TH-ASN]:[PROD-WORKLOAD-NO]"
            }
          }
        },
        {
          "rule-number": 202,
          "rule-definition": {
