{
  "description": "Cloud WAN attachment routing policies for TH Prod cross-connect (DX + VPN backup)",
  "notes": [
    "Replace placeholders [AWS-TH-ASN], [PROD-WORKLOAD-NO], [SHARED-SERVICE-NO] with actual values",
    "Example: AWS-TH-ASN = 64520, PROD-WORKLOAD-NO = 100, SHARED-SERVICE-NO = 200",
    "Non-terminal actions (summarize, prepend-asn-list, add-community, set-local-preference) must come BEFORE terminal actions (allow, drop)",
    "GLOBAL-DEFAULT: prefix list with min/max=0 matching only 0.0.0.0/0 exactly",
    "GLOBAL-CATCH-ALL: prefix list matching any IPv4 prefix (implicit deny catch-all)"
  ],
  "attachment-routing-policy-rules": [
    {
      "rule-number": 200,
      "description": "Apply BNA-THDX policies to BNA Direct Connect Gateway attachment",
      "conditions": [
        {
          "type": "routing-policy-label",
          "value": "BNA-THDX"
        }
      ],
      "action": {
        "associate-routing-policies": [
          "BNA-THDX-Outbound",
          "BNA-THDX-Inbound"
        ]
      }
    },
    {
      "rule-number": 210,
      "description": "Apply MTG-THDX policies to MTG Direct Connect Gateway attachment",
      "conditions": [
        {
          "type": "routing-policy-label",
          "value": "MTG-THDX"
        }
      ],
      "action": {
