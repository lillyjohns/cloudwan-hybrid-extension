{
 "version": "2025.11",
 "core-network-configuration": {
  "asn-ranges": [
   "64512-64521"
  ],
  "edge-locations": [
   {
    "location": "us-west-2",
    "asn": 64512
   },
   {
    "location": "ap-southeast-2",
    "asn": 64513
   }
  ]
 },
 "segments": [
  {
   "name": "nonprod",
   "require-attachment-acceptance": false
  },
  {
   "name": "prod",
   "require-attachment-acceptance": false
  },
  {
   "name": "sharedservices",
   "require-attachment-acceptance": false
  },
  {
   "name": "onprem",
   "require-attachment-acceptance": false
  }
 ],
 "attachment-routing-policy-rules": [
  {
   "rule-number": 200,
   "description": "Apply DC1 DX policies",
   "conditions": [
    {
     "type": "routing-policy-label",
     "value": "DC1DX"
    }
   ],
   "action": {
    "associate-routing-policies": [
     "DC1DXOutbound",
     "DC1DXInbound"
    ]
   }
  }
 ],
 "routing-policies": [
  {
   "routing-policy-name": "DC1DXOutbound",
   "routing-policy-description": "Selective allow to DC1 over DX",
   "routing-policy-direction": "outbound",
   "routing-policy-number": 200,
   "routing-policy-rules": [
    {
     "rule-number": 100,
     "rule-definition": {
      "match-conditions": [
       {
        "type": "prefix-equals",
        "value": "172.21.0.0/24"
       },
       {
        "type": "prefix-equals",
        "value": "10.2.0.0/16"
       }
      ],
      "condition-logic": "or",
      "action": {
       "type": "allow"
      }
     }
    },
    {
     "rule-number": 900,
     "rule-definition": {
      "match-conditions": [
       {
        "type": "prefix-in-cidr",
        "value": "0.0.0.0/0"
       }
      ],
      "condition-logic": "or",
      "action": {
       "type": "drop"
      }
     }
    }
   ]
  },
  {
   "routing-policy-name": "DC1DXInbound",
   "routing-policy-description": "Accept DC1 summary + /32 exception with LP1000",
   "routing-policy-direction": "inbound",
   "routing-policy-number": 201,
   "routing-policy-rules": [
    {
     "rule-number": 120,
     "rule-definition": {
      "match-conditions": [
       {
        "type": "prefix-equals",
        "value": "10.1.255.1/32"
       }
      ],
      "condition-logic": "or",
      "action": {
       "type": "set-local-preference",
       "value": "1000"
      }
     }
    },
    {
     "rule-number": 121,
     "rule-definition": {
      "match-conditions": [
       {
        "type": "prefix-equals",
        "value": "10.1.255.1/32"
       }
      ],
      "condition-logic": "or",
      "action": {
       "type": "allow"
      }
     }
    },
    {
     "rule-number": 200,
     "rule-definition": {
      "match-conditions": [
       {
        "type": "prefix-in-cidr",
        "value": "10.1.0.0/16"
       }
      ],
      "condition-logic": "or",
      "action": {
       "type": "allow"
      }
     }
    },
    {
     "rule-number": 900,
     "rule-definition": {
      "match-conditions": [
       {
        "type": "prefix-in-cidr",
        "value": "0.0.0.0/0"
       }
      ],
      "condition-logic": "or",
      "action": {
       "type": "drop"
      }
     }
    }
   ]
  }
 ],
 "attachment-policies": [
  {
   "rule-number": 100,
   "conditions": [
    {
     "type": "tag-exists",
     "key": "segment"
    }
   ],
   "action": {
    "association-method": "tag",
    "tag-value-of-key": "segment"
   }
  }
 ],
 "segment-actions": [
  {
   "action": "share",
   "segment": "sharedservices",
   "mode": "attachment-route",
   "share-with": "*"
  },
  {
   "action": "share",
   "segment": "onprem",
   "mode": "attachment-route",
   "share-with": "*"
  }
 ]
}